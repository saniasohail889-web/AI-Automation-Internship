    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// --- Normalize inputs (humans write '≈ $12,500', '1.5k', etc.) ---\nconst raw = $json.amount;\nlet amount = 0;\nif (typeof raw === 'number') {\n  amount = raw;\n} else if (raw != null) {\n  let s = String(raw).trim().toLowerCase().replace(/[$,\\s]/g, '');\n  const k = s.endsWith('k');\n  if (k) s = s.slice(0, -1);\n  const n = parseFloat(s);\n  amount = isNaN(n) ? 0 : (k ? n * 1000 : n);\n}\n\nconst reason = ($json.reason == null ? '' : String($json.reason)).trim();\nconst words = reason ? reason.split(/\\s+/).length : 0;\n\n// --- Deterministic risk rules ---\nconst HIGH_AMOUNT = 500;\nconst MID_AMOUNT = 200;\nconst reasons = [];\nlet score = 0;\n\nif (amount >= HIGH_AMOUNT) { score += 2; reasons.push('Unusually high amount (>= $' + HIGH_AMOUNT + ')'); }\nelse if (amount >= MID_AMOUNT) { score += 1; reasons.push('Moderate amount (>= $' + MID_AMOUNT + ')'); }\n\nif (words < 4) { score += 2; reasons.push('Vague / very short reason (' + words + ' words)'); }\nelse if (words < 8) { score += 1; reasons.push('Somewhat brief reason (' + words + ' words)'); }\n\nif (amount <= 0) { score += 2; reasons.push('Missing or unparseable amount'); }\n\nconst abuseTerms = ['again', 'always', 'every time', 'chargeback', 'dispute', 'lawyer', 'scam'];\nconst lc = reason.toLowerCase();\nfor (const t of abuseTerms) { if (lc.includes(t)) { score += 1; reasons.push('Reason contains risk keyword: \"' + t + '\"'); } }\n\n// --- Derive recommendation + confidence from score ---\nlet risk_level, recommendation, confidence;\nif (score >= 3) { risk_level = 'High'; recommendation = 'Reject'; confidence = 'High'; }\nelse if (score >= 1) { risk_level = 'Medium'; recommendation = 'Reject'; confidence = 'Medium'; }\nelse { risk_level = 'Low'; recommendation = 'Approve'; confidence = 'High'; }\n\nif (reasons.length === 0) reasons.push('No risk factors detected');\nconst risk_reasons = reasons.join('; ');\n\nconst summary = 'Recommendation: ' + recommendation + '\\n' +\n  'Confidence: ' + confidence + '\\n' +\n  'Risk level: ' + risk_level + '\\n' +\n  'Reasoning: ' + risk_reasons;\n\n// Structured log line for execution history / observability\nconsole.log('[RiskAssessment] order=' + ($json.order_id || 'n/a') +\n  ' amount=' + amount + ' score=' + score + ' rec=' + recommendation + ' risk=' + risk_level);\n\nreturn { json: { ...$json, amount_parsed: amount, system_recommendation: recommendation, confidence, risk_level, risk_reasons, assessment_summary: summary } };"
      },
