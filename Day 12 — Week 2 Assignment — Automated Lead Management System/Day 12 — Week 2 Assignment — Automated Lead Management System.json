    {
      "parameters": {
        "jsCode": "const lead = $input.first().json.body;\n\nconst requiredFields = [\n  \"name\",\n  \"email\",\n  \"company\",\n  \"service\",\n  \"budget\"\n];\n\nconst missingFields = requiredFields.filter(\n  field => !lead[field] && lead[field] !== 0\n);\n\nreturn [\n  {\n    json: {\n      ...lead,\n      valid: missingFields.length === 0,\n      missingFields\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -48,
        -16
      ],
      "id": "2e66a407-7472-4863-8f8a-ee1fb57fac77",
      "name": "validation"
