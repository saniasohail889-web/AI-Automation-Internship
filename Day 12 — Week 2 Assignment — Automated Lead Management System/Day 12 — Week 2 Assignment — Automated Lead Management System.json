    {
      "parameters": {
        "jsCode": "const lead = $input.first().json;\n\nconst budget = Number(lead.budget);\nconst service = String(lead.service || \"\").toLowerCase();\n\nlet score = 0;\n\n// Budget scoring\nif (budget >= 150000) {\n  score += 50;\n} else if (budget >= 100000) {\n  score += 30;\n} else if (budget >= 50000) {\n  score += 20;\n}\n\n// Service scoring\nif (service.includes(\"ai\")) {\n  score += 30;\n} else if (service.includes(\"automation\")) {\n  score += 25;\n} else if (service.includes(\"web\")) {\n  score += 20;\n}\n\n// Priority\nlet priority;\n\nif (score >= 70) {\n  priority = \"High\";\n} else if (score >= 40) {\n  priority = \"Medium\";\n} else {\n  priority = \"Low\";\n}\n\nreturn [\n  {\n    json: {\n      ...lead,\n      score,\n      priority\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
