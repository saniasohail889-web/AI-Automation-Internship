    {
      "parameters": {
        "text": "=Position applied for: {{ $(\"Application\").item.json.position }}\n\nResume:\n{{ $(\"Extract Resume Text\").item.json.text }}",
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\"skills\":[\"JavaScript\",\"Python\",\"AWS\"],\"experience_years\":5,\"score\":78,\"recommendation\":\"shortlist\",\"reason\":\"Strong match on required skills and relevant seniority.\",\"summary\":\"Concise 1-2 sentence profile of the candidate.\"}",
        "options": {
          "systemPromptTemplate": "You are an AI recruitment assistant. You ANALYZE and ASSIST only — you never make the final hiring decision, a human does. From the candidate's resume and the position applied for, extract a structured assessment. Rules: (1) skills = concrete technical/professional skills evidenced in the resume. (2) experience_years = total relevant professional years as a number (estimate conservatively, use 0 if unclear). (3) score = integer 0-100 measuring fit for the stated position. (4) recommendation = one of \"shortlist\", \"maybe\", or \"reject\" based purely on fit. (5) reason = one short, factual sentence justifying the score/recommendation. (6) summary = 1-2 neutral sentences. Be objective, avoid bias regarding age, gender, ethnicity, or personal attributes; assess only skills and experience."
        }
      },
      "id": "5e7e282f-9834-487d-9c67-aa2abccdc53d",
      "name": "AI Analysis",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        352,
        80
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "51e35fc9-d9c2-40b5-bd27-b2df97b0ec88",
      "name": "OpenAI Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        576,
        256
      ],
      "credentials": {
        "openAiApi": {
          "id": "yRJZVc5tNAVjKR9W",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Combine AI analysis with deterministic business rules.\nconst form = $('Application').item.json;\nconst aiRaw = $('AI Analysis').item.json;\nconst ai = aiRaw && aiRaw.output ? aiRaw.output : aiRaw || {};\n\n// --- normalize AI fields ---\nlet skills = ai.skills;\nif (Array.isArray(skills)) skills = skills.join(', ');\nskills = (skills || '').toString().trim();\n\nlet years = Number(ai.experience_years);\nif (!isFinite(years) || years < 0) years = 0;\n\nlet score = Number(ai.score);\nif (!isFinite(score)) score = 0;\nscore = Math.max(0, Math.min(100, Math.round(score)));\n\nlet aiRec = (ai.recommendation || '').toString().toLowerCase().trim();\nif (!['shortlist', 'maybe', 'reject'].includes(aiRec)) aiRec = 'maybe';\n\nconst reason = (ai.reason || ai.summary || 'No AI reason provided.').toString().trim();\n\n// --- deterministic rule flags ---\nconst flags = [];\nif (!skills) flags.push('no_skills_detected');\nif (years < 2) flags.push('junior_experience');\nif (score < 40) flags.push('low_ai_score');\nif (score >= 80) flags.push('high_ai_score');\nif (!form.email || !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(String(form.email))) {\n  flags.push('invalid_email');\n}\n\n// --- combined system recommendation (AI + rules) ---\nlet systemRecommendation = aiRec;\nif (score >= 70 && years >= 2) systemRecommendation = 'shortlist';\nelse if (score < 40) systemRecommendation = 'reject';\n\nreturn [{\n  json: {\n    candidate_name: form.candidate_name || '',\n    email: form.email || '',\n    phone: form.phone || '',\n    position: form.position || '',\n    resume_text: ($('Extract Resume Text').item.json.text || '').toString().slice(0, 5000),\n    skills,\n    experience_years: years,\n    ai_score: score,\n    ai_recommendation: aiRec,\n    ai_reason: reason,\n    rule_flags: flags.join(', ') || 'none',\n    system_recommendation: systemRecommendation,\n    status: 'pending_review',\n    execution_id: $execution.id,\n  },\n}];"
      },
      "id": "8028e093-3f4b-4787-a26a-79b933c5ef1c",
      "name": "Rule-Based Assessment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        96
      ]
