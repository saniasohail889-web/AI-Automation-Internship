        "text": "={{ $json.body.message || $json.body.customerMessage }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"category\", \"priority\", \"sentiment\", \"department\", \"summary\", \"suggested_response\"],\n  \"properties\": {\n    \"category\": { \"type\": \"string\", \"enum\": [\"Billing\", \"Technical\", \"Account\", \"Sales\", \"General\"], \"description\": \"The main topic of the customer message.\" },\n    \"priority\": { \"type\": \"string\", \"enum\": [\"Low\", \"Medium\", \"High\", \"Urgent\"], \"description\": \"How urgently this needs a response. Use Urgent for outages, security, payment failures, or angry churn risk.\" },\n    \"sentiment\": { \"type\": \"string\", \"enum\": [\"Positive\", \"Neutral\", \"Negative\"], \"description\": \"The emotional tone of the customer message.\" },\n    \"department\": { \"type\": \"string\", \"enum\": [\"Billing\", \"Support\", \"Sales\", \"Customer Success\"], \"description\": \"The team that should handle this ticket.\" },\n    \"summary\": { \"type\": \"string\", \"description\": \"A one or two sentence neutral summary of the issue.\" },\n    \"suggested_response\": { \"type\": \"string\", \"description\": \"A polite, professional draft reply addressed to the customer that acknowledges the issue and outlines next steps.\" }\n  }\n}",
        "options": {
          "systemPromptTemplate": "You are an expert customer support triage assistant. Read the customer message and extract structured triage data strictly following the provided JSON schema. Choose exactly one enum value for each classification field. Keep the summary neutral and concise. Write the suggested_response as a courteous reply to the customer."
        }
      },
